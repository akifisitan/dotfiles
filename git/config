[commit]
  template = ~/.config/git/template
  verbose = true
  gpgsign = true

[gpg]
  format = ssh

[include]
  path = ~/.gitconfig.local

[init]
  defaultBranch = main

[core]
  autocrlf = false
  fsync = none
  fscache = true
  symlinks = true
  editor = "code --wait"
  preloadindex = true
  longPaths = true

[push]
  autoSetupRemote = true
  default = current

[pull]
  rebase = true

[rebase]
  autoStash = true
  missingCommitsCheck = warn  # warn if rebasing with missing commits

[pack]
  threads = 0
  windowMemory = 1g
  packSizeLimit = 1g

[status]
  branch = true
  # short = true
  showStash = true
  showUntrackedFiles = all

[branch]
  sort = -committerdate

[tag]
  sort = -taggerdate
  gpgsign = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[safe]
  directory = *
