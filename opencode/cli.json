{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "github",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "prompt": {
    "editor": true,
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "debug": {
    "devtools": false
  }
}
